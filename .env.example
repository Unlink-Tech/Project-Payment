# Contact form delivery via Amazon SES.
# Copy to .env.local for local development. In production, set these in the
# PM2 process environment on the Lightsail server — never commit or upload real values.
# All are server-only: never prefix them with NEXT_PUBLIC_.

# SES region the ease-plus.com identity is verified in, e.g. ap-southeast-1 (Singapore).
AWS_REGION=

# IAM user whose only permission is ses:SendEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be an address on the SES-verified domain.
SES_FROM_EMAIL="Ease Plus Website <noreply@ease-plus.com>"
SES_TO_EMAIL=sales@ease-plus.com
